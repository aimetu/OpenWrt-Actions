# dns
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=n
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-smartdns_INCLUDE_WebUI=y
CONFIG_PACKAGE_luci-app-oxidns=y

# luci
CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_luci-app-athena-led=y
CONFIG_PACKAGE_luci-app-cloudflared=y
CONFIG_PACKAGE_luci-app-filebrowser-go=n
CONFIG_PACKAGE_luci-app-minidlna=n
CONFIG_PACKAGE_luci-app-openlist=y
CONFIG_PACKAGE_luci-app-timewol=n
CONFIG_PACKAGE_luci-app-uhttpd=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-wifihistory=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-unishare=y

# CONFIG_PACKAGE_luci-app-samba4=n
# CONFIG_PACKAGE_luci-app-syncthing=n
# CONFIG_PACKAGE_luci-app-oaf=n

# theme
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# CONFIG_PACKAGE_luci-theme-aurora=n
# CONFIG_PACKAGE_luci-app-aurora-config=n

# proxy
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-app-momo=y

# CONFIG_PACKAGE_luci-app-clashoo=n
# CONFIG_PACKAGE_luci-app-csing-box=n
# CONFIG_PACKAGE_luci-app-ssclash=n
# CONFIG_PACKAGE_luci-app-ssclash_Iptables_Transparent_Proxy is not set
# CONFIG_PACKAGE_luci-app-ssclash_Nftables_Transparent_Proxy=y
